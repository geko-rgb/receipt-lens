{
  "name": "receipt-lens",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck && tsc -p .",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "playwright test --config playwright/playwright.config.ts",
    "test:offline": "playwright test --config playwright/playwright.config.ts --grep @offline",
    "scan:egress": "node scripts/scan-egress.mjs",
    "fetch:datasets": "node scripts/fetch-datasets.mjs",
    "generate:fixtures": "pnpm build && node benchmarks/dist/generate-fixtures.js",
    "verify:fixtures": "pnpm build && node benchmarks/dist/generate-fixtures.js --check",
    "scan:pii": "pnpm build && node benchmarks/dist/scan-pii.js",
    "report:results": "pnpm build && node benchmarks/dist/report-results.js",
    "verify:results": "pnpm build && node benchmarks/dist/report-results.js --check",
    "measure:accuracy": "pnpm build && node benchmarks/dist/measure-accuracy.js",
    "verify:accuracy": "pnpm build && node benchmarks/dist/measure-accuracy.js --check && node benchmarks/dist/measure-accuracy.js --split eval --check",
    "run:end-to-end": "pnpm build && node benchmarks/scripts/run-end-to-end.mjs",
    "render:accuracy": "node benchmarks/scripts/render-accuracy-table.mjs --write",
    "verify:accuracy-table": "node benchmarks/scripts/render-accuracy-table.mjs --check",
    "measure:footprint": "pnpm build && node benchmarks/scripts/measure-footprint.mjs",
    "render:footprint": "node benchmarks/scripts/render-footprint-table.mjs --write",
    "verify:footprint": "node benchmarks/scripts/render-footprint-table.mjs --check"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
