{
  "name": "@receipt-lens/core",
  "version": "0.0.0",
  "type": "module",
  "description": "Privacy-first in-browser receipt parsing: staged OCR, deterministic parsing, conditional validation.",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "onnxruntime-web": "^1.31.1"
  }
}
