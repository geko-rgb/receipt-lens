{
  "name": "@receipt-lens/pwa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@receipt-lens/core": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p . && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc -p . --noEmit && tsc -p tsconfig.test.json && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.57.3",
    "svelte-check": "^4.7.8",
    "vite": "8.3.5"
  }
}
