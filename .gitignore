benchmarks/datasets/.fetch-stamp

# locally retained receipt photos (dev/test scratch convention; app-level
# opt-in retention lives in browser storage, never committed)
receipts-retained/

# The two acceptance photographs (Saravana Bhavan, KOT counter). Never committed: they are
# third-party receipt scans, and this repo is public (DECISIONS/0005). The committed, redacted
# replay of their OCR (`packages/core/src/parse/real-ocr-fixtures.ts`) is the CI artifact; the
# photographs stay a local image-level gate that `playwright/real-receipts.spec.ts` skips when
# absent. Adding them is a deliberate owner decision, not an accident.
images/

# harness run artifacts (raw OcrResult JSON + screenshots of real receipts)
harness/out/

# ticket 09b: candidate model tier for the G3 comparison. Never committed — a tier
# that has not won the gate does not join the shipped asset set, and the footprint
# check must keep verifying the assets the product actually serves (DECISIONS/0012 F11).
# Experiment leftovers (ticket 26's PP-OCRv6 Small tier) are quarantined *here*, not in
# assets/models/, which serve-app.mjs serves verbatim; the directory's contents are pinned
# to the manifest by packages/core/src/ocr/model-assets.test.ts.
assets/models/candidate/
# Ticket 14: the migration rig's build output — a test entry, never shipped, and it
# copies the 14.85 MB ORT wasm alongside the rig chunk (DECISIONS/0023 S1).
packages/pwa/rig/dist/
